{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch-question.v1.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "blocking": {
      "type": "boolean"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "header": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allow_other": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "options",
          "allow_other"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "v",
    "question_id",
    "blocking",
    "questions"
  ],
  "additionalProperties": false
}
