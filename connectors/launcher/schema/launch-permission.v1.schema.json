{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch-permission.v1.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "enum": [
        "exec",
        "edit",
        "network",
        "mcp_tool",
        "other"
      ]
    },
    "machine_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "permission_mode": {
      "enum": [
        "read-only",
        "ask",
        "auto",
        "full-access"
      ]
    },
    "preset": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "backend_method": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "line": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "shell_operators": {
          "type": "boolean"
        }
      },
      "required": [
        "shell_operators"
      ],
      "additionalProperties": false
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+)"
          },
          "access": {
            "enum": [
              "read",
              "write",
              "delete",
              "move"
            ]
          },
          "in_workspace": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "access",
          "in_workspace"
        ],
        "additionalProperties": false
      }
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "scope": {
      "enum": [
        "once",
        "session",
        "always"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "grants": {
            "enum": [
              "once",
              "session",
              "always",
              "deny",
              "deny_always",
              "cancel"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "grants"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 8
    },
    "workspace_root": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+)"
    },
    "outside_workspace": {
      "enum": [
        true,
        false,
        "unknown"
      ]
    },
    "reason": {
      "type": "string"
    },
    "backend_raw": {},
    "backend_raw_truncated": {
      "type": "boolean"
    },
    "backend_raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "redacted": {
      "type": "boolean"
    },
    "fidelity": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "enforced",
            "reported"
          ]
        },
        "command": {
          "enum": [
            "argv",
            "line",
            "none"
          ]
        },
        "paths": {
          "enum": [
            "enforced",
            "reported",
            "none"
          ]
        },
        "host": {
          "enum": [
            "enforced",
            "reported",
            "none"
          ]
        }
      },
      "required": [
        "kind",
        "command",
        "paths",
        "host"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "kind",
    "machine_id",
    "job_id",
    "permission_mode",
    "preset",
    "backend",
    "backend_method",
    "scope",
    "options",
    "workspace_root",
    "outside_workspace",
    "backend_raw",
    "backend_raw_truncated",
    "redacted",
    "fidelity"
  ],
  "additionalProperties": false
}
