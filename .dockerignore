.git
.worktrees/
.scratch/
.data/
bin/
node_modules/
target/
dist/
build/
.venv/
*.log
.env
.env.*
docs/prototypes/
docs/research/
# Hub databases and their backups hold meta.hub_key: never in a build context.
backups/
.demo-data/
# ** also matches the root, so these catch a database at any depth.
**/*.db
**/*.db-wal
**/*.db-shm
# The CLI embeds the connector runtime sources. Keep these in the build context.
connectors/launcher/test/
connectors/hub-client/test/
**/node_modules/

# Operator-only spike inputs must never enter git or a remote build context.
**/r2-test.env
**/r2-spike*.env
**/r2-credentials*
**/*.pem
**/*.key
**/credentials*

# Generated evidence media is not part of the application build.
# .scratch/ and docs/prototypes/ are already excluded above.
docs/plans/**/*.[pP][nN][gG]
docs/plans/**/*.[jJ][pP][gG]
docs/plans/**/*.[jJ][pP][eE][gG]
docs/plans/**/*.[gG][iI][fF]
docs/plans/**/*.[wW][eE][bB][pP]
